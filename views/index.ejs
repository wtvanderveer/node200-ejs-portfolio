<%- include('partials/header', { title: 'Travis Vanderveer | Portfolio' }) %>

<section class="hero text-white">
    <div class="container py-5">
        <p class="text-uppercase small fw-semibold letter-spaced mb-2">Full-stack JavaScript developer</p>
        <h1 class="display-4 fw-bold">Hi, I'm <span class="text-neon">Travis</span>.</h1>
        <p class="lead col-lg-7">I build web apps with React, Node, and Express. Here are a few things I've made recently.</p>
        <div class="d-flex flex-wrap gap-2 mt-4">
            <a class="btn btn-neon btn-lg" href="/portfolio">See my work</a>
            <a class="btn btn-outline-neon btn-lg" href="https://github.com/wtvanderveer" target="_blank" rel="noopener">GitHub</a>
        </div>
    </div>
</section>

<section class="container py-5">
    <div class="d-flex justify-content-between align-items-baseline mb-4">
        <h2 class="h3 mb-0">Featured projects</h2>
        <a href="/portfolio">All projects &rarr;</a>
    </div>
    <div class="row g-4">
        <% projects.forEach((project) => { %>
            <%- include('partials/project-card', { project }) %>
        <% }) %>
    </div>
</section>

<section class="container">
    <div class="cta rounded-3 p-4 p-md-5 text-center">
        <h2 class="h3">Want to work together?</h2>
        <p class="text-body-secondary">Leave your name and email and I'll get back to you.</p>
        <a class="btn btn-neon" href="/contact">Get in touch</a>
    </div>
</section>

<%- include('partials/footer') %>
