# Copy this file to .env and fill in the values.

# The ID from your sheet's URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
#SHEET_ID=

# Optional: which tab and columns to write to. Defaults to Sheet1!A:D
# SHEET_RANGE=Sheet1!A:D

# Locally, put the service account key in credentials.json in the project root.
# On Render, paste the whole JSON key here as one line instead.
# GOOGLE_CREDENTIALS=
